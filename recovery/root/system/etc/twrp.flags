# mount point	fstype	device	device2						flags
/system_root   ext4 /dev/block/platform/13500000.dwmmc0/by-name/system  flags=backup=1;wipeingui;display="System"
/product       ext4 /dev/block/platform/13500000.dwmmc0/by-name/product  flags=backup=1;wipeingui;display="Product"
/optics        ext4 /dev/block/platform/13500000.dwmmc0/by-name/optics  flags=backup=1;wipeingui;display="Optics"
/prism         ext4 /dev/block/platform/13500000.dwmmc0/by-name/prism  flags=backup=1;wipeingui;display="Prism"
/odm           ext4 /dev/block/platform/13500000.dwmmc0/by-name/odm  flags=backup=1;wipeingui;display="Odm"
/vendor        ext4 /dev/block/platform/13500000.dwmmc0/by-name/vendor  flags=backup=1;wipeingui;display="Vendor"

/boot		emmc	/dev/block/platform/13500000.dwmmc0/by-name/boot	flags=backup=1;display="Boot"
/recovery	emmc	/dev/block/platform/13500000.dwmmc0/by-name/recovery	flags=backup=1;display="Recovery"
/data		ext4	/dev/block/platform/13500000.dwmmc0/by-name/userdata	flags=wait;encryptable=footer;length=-20480
/cache		ext4	/dev/block/platform/13500000.dwmmc0/by-name/cache	flags=backup=1;display="Cache"
/efs		ext4	/dev/block/platform/13500000.dwmmc0/by-name/efs		flags=backup=1;display="EFS"
/cpefs		ext4	/dev/block/platform/13500000.dwmmc0/by-name/cpefs	flags=backup=1;subpartitionof=/efs
/omr            ext4    /dev/block/platform/13500000.dwmmc0/by-name/omr flags=backup=1;wipeingui;display="OMR"
/modem		emmc	/dev/block/platform/13500000.dwmmc0/by-name/radio	flags=backup=1;display="Modem"
/misc		emmc	/dev/block/platform/13500000.dwmmc0/by-name/misc    flags=backup=1;display="Misc"
/cp_debug	emmc	/dev/block/platform/13500000.dwmmc0/by-name/cp_debug	flags=backup=1;display="CP Debug"
/param		emmc	/dev/block/platform/13500000.dwmmc0/by-name/param	flags=backup=1;display="Param"
/dtb		emmc	/dev/block/platform/13500000.dwmmc0/by-name/dtb		flags=backup=1;display="DTB"
/dtbo		emmc	/dev/block/platform/13500000.dwmmc0/by-name/dtbo	flags=backup=1;display="DTBO"

# Removable storage
/external_sd	vfat	/dev/block/mmcblk1p1	/dev/block/mmcblk1		flags=storage;wipeingui;removable
/usb-otg	vfat	/dev/block/sda1	/dev/block/sda				flags=display="USB-OTG";storage;wipeingui;removable
